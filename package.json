{
  "name": "token-governor",
  "version": "0.1.0",
  "description": "Governor 207: budget control for AI agents inside VS Code.",
  "private": true,
  "type": "module",
  "bin": {
    "token-governor": "./cli/codex-governor.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smokeybear10/207.PROJ.governor.git"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "governor": "tsx cli/token-governor.ts",
    "station:rehearsal": "tsx station/rehearsal-server.ts",
    "station:demo": "bash station/run-demo.sh",
    "governor:codex": "node cli/codex-governor.mjs",
    "benchmark:repair": "tsx cli/repair-benchmark.ts",
    "start": "tsx server/main.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/governor-core.test.ts tests/governor-cost-ledger.test.ts tests/governor-policy.test.ts tests/governor-log-reducer.test.ts",
    "test:api": "vitest run tests/app.test.ts tests/server-startup.test.ts tests/openai-client.test.ts tests/governed-executor.test.ts tests/jobs-api.test.ts tests/cli.test.ts",
    "test:codex": "vitest run tests/codex-extension.test.ts",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
