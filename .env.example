# Reserved for the TokenGovernor Responses API implementation.
OPENAI_API_KEY=

# Provider mode for the governed executor:
#   fake   - fully scripted, deterministic, $0 (default; CI/offline dev)
#   hybrid - real (free) /input_tokens preflight + scripted generation, $0
#   live   - real OpenAI generation (requires OPENAI_API_KEY)
GOVERNOR_PROVIDER_MODE=fake

# Model used for live/hybrid governed calls. Must have a matching rate card.
GOVERNOR_MODEL=gpt-5-nano

# Local API server.
HOST=127.0.0.1
PORT=8787
