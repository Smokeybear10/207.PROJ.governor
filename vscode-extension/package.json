{
  "name": "token-governor-vscode",
  "displayName": "Governor",
  "description": "Set spending limits for AI requests and review proposed Node test repairs in VS Code.",
  "version": "0.2.0",
  "private": true,
  "publisher": "governor",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smokeybear10/207.PROJ.governor.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=governor.token-governor-vscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "tokenGovernor.healthCheck",
        "category": "Governor",
        "title": "Health Check"
      },
      {
        "command": "tokenGovernor.refresh",
        "category": "Governor",
        "title": "Refresh Job View",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenGovernor.createJob",
        "category": "Governor",
        "title": "Create Job",
        "icon": "$(add)"
      },
      {
        "command": "tokenGovernor.setActiveJob",
        "category": "Governor",
        "title": "Browse Saved Jobs"
      },
      {
        "command": "tokenGovernor.viewResponses",
        "category": "Governor",
        "title": "View Saved Responses"
      },
      {
        "command": "tokenGovernor.exportReport",
        "category": "Governor",
        "title": "Export Job Report"
      },
      {
        "command": "tokenGovernor.openJobPanel",
        "category": "Governor",
        "title": "Open Job View"
      },
      {
        "command": "tokenGovernor.submitSelection",
        "category": "Governor",
        "title": "Submit Selection Through Governor"
      },
      {
        "command": "tokenGovernor.sendPrompt",
        "category": "Governor",
        "title": "Send Prompt Through Governor"
      },
      {
        "command": "tokenGovernor.finalize",
        "category": "Governor",
        "title": "Finalize Pending Response"
      },
      {
        "command": "tokenGovernor.repairWorkspace",
        "category": "Governor",
        "title": "Repair Workspace Test"
      },
      {
        "command": "tokenGovernor.reviewWorkspaceRepair",
        "category": "Governor",
        "title": "Review Workspace Repair"
      },
      {
        "command": "tokenGovernor.runRepair",
        "category": "Governor",
        "title": "Run Sample CI Repair"
      },
      {
        "command": "tokenGovernor.setOpenAiApiKey",
        "category": "Governor",
        "title": "Set OpenAI API Key",
        "icon": "$(key)"
      },
      {
        "command": "tokenGovernor.clearOpenAiApiKey",
        "category": "Governor",
        "title": "Clear OpenAI API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenGovernor",
          "title": "Governor",
          "icon": "media/governor.svg"
        }
      ]
    },
    "views": {
      "tokenGovernor": [
        {
          "type": "webview",
          "id": "tokenGovernor.jobView",
          "name": "Active Job"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokenGovernor.refresh",
          "when": "view == tokenGovernor.jobView",
          "group": "navigation@1"
        },
        {
          "command": "tokenGovernor.createJob",
          "when": "view == tokenGovernor.jobView",
          "group": "navigation@2"
        },
        {
          "command": "tokenGovernor.setOpenAiApiKey",
          "when": "view == tokenGovernor.jobView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Governor",
      "properties": {
        "tokenGovernor.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the Governor API. The packaged local service is managed automatically for a loopback HTTP URL."
        },
        "tokenGovernor.autoStartLocalServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start and stop the packaged Governor service for a loopback API URL."
        },
        "tokenGovernor.requestTimeoutMs": {
          "type": "integer",
          "default": 70000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Maximum time to wait for a Governor API request, in milliseconds."
        },
        "tokenGovernor.pollIntervalMs": {
          "type": "integer",
          "default": 2000,
          "minimum": 500,
          "maximum": 300000,
          "description": "How often to refresh the active job, in milliseconds."
        },
        "tokenGovernor.defaultFixtureId": {
          "type": "string",
          "default": "broken-sum",
          "description": "Bundled fixture used by Run Sample CI Repair. Samples use scripted responses without model calls."
        },
        "tokenGovernor.providerMode": {
          "type": "string",
          "enum": [
            "fake",
            "hybrid",
            "live"
          ],
          "default": "fake",
          "description": "Legacy sample provider mode.",
          "deprecationMessage": "Samples now always use scripted responses without model calls. Workspace repairs use your configured OpenAI provider."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "tsc -w -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run compile && node ./out/test/runTest.js",
    "build": "npm run compile",
    "package": "npm run build && vsce package --no-dependencies -o token-governor-vscode.vsix",
    "publish:mock": "node scripts/mock-publish.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.19.9",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "glob": "^14.0.4",
    "iconv-lite": "0.7.3",
    "mime-types": "3.0.2",
    "mocha": "^11.7.6",
    "proper-lockfile": "4.1.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "zod": "4.6.7"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.1.3",
      "glob": "$glob",
      "minimatch": "11.0.5"
    },
    "@vscode/vsce": {
      "glob": "$glob",
      "minimatch": "11.0.5"
    }
  }
}
