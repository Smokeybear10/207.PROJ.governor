{
  "name": "token-governor-vscode",
  "displayName": "Governor",
  "description": "Local budget control for AI jobs inside the editor: watch spend, reservations, and risk live, and run governed CI-repair — all capped by Governor.",
  "version": "0.2.0",
  "private": true,
  "publisher": "governor",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smokeybear10/207.PROJ.governor.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=governor.token-governor-vscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "tokenGovernor.healthCheck",
        "category": "Governor",
        "title": "Health Check"
      },
      {
        "command": "tokenGovernor.createJob",
        "category": "Governor",
        "title": "Create Job"
      },
      {
        "command": "tokenGovernor.setActiveJob",
        "category": "Governor",
        "title": "Set Active Job"
      },
      {
        "command": "tokenGovernor.openJobPanel",
        "category": "Governor",
        "title": "Open Job View"
      },
      {
        "command": "tokenGovernor.submitSelection",
        "category": "Governor",
        "title": "Submit Selection Through Governor"
      },
      {
        "command": "tokenGovernor.sendPrompt",
        "category": "Governor",
        "title": "Send Prompt Through Governor"
      },
      {
        "command": "tokenGovernor.finalize",
        "category": "Governor",
        "title": "Finalize Pending Response"
      },
      {
        "command": "tokenGovernor.runRepair",
        "category": "Governor",
        "title": "Run Governed CI-Repair"
      },
      {
        "command": "tokenGovernor.setOpenAiApiKey",
        "category": "Governor",
        "title": "Set OpenAI API Key"
      },
      {
        "command": "tokenGovernor.clearOpenAiApiKey",
        "category": "Governor",
        "title": "Clear OpenAI API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenGovernor",
          "title": "Governor",
          "icon": "media/governor.svg"
        }
      ]
    },
    "views": {
      "tokenGovernor": [
        {
          "type": "webview",
          "id": "tokenGovernor.jobView",
          "name": "Active Job"
        }
      ]
    },
    "configuration": {
      "title": "Governor",
      "properties": {
        "tokenGovernor.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the Governor API. The packaged local service is managed automatically for a loopback HTTP URL."
        },
        "tokenGovernor.autoStartLocalServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start and stop the packaged Governor service for a loopback API URL."
        },
        "tokenGovernor.requestTimeoutMs": {
          "type": "number",
          "default": 70000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Maximum time to wait for a Governor API request, in milliseconds."
        },
        "tokenGovernor.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "How often to refresh the active job, in milliseconds."
        },
        "tokenGovernor.defaultFixtureId": {
          "type": "string",
          "default": "broken-sum",
          "description": "Repair fixture used by the Run Governed CI-Repair command."
        },
        "tokenGovernor.providerMode": {
          "type": "string",
          "enum": [
            "fake",
            "hybrid",
            "live"
          ],
          "default": "fake",
          "description": "Provider mode used by governed CI-Repair runs."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "tsc -w -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:vscode": "npm run compile && node ./out/test/runTest.js",
    "build": "npm run compile",
    "package": "npm run build && vsce package --no-dependencies -o token-governor-vscode.vsix",
    "publish:mock": "node scripts/mock-publish.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.19.9",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "glob": "^13.0.6",
    "iconv-lite": "0.7.3",
    "mime-types": "3.0.2",
    "mocha": "^11.7.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.7"
    }
  }
}
